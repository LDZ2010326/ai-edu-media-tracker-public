# Publication is opt-in. Use an absolute executable; do not commit a populated .env file.
# LARK_CLI_PATH=/absolute/path/to/lark-cli
# This is a target Wiki node identifier, not an authentication credential.
# Authentication is managed separately by `lark-cli auth` / the selected lark-cli profile.
# FEISHU_WIKI_NODE_TOKEN=replace-with-wiki-node-token
# Optional absolute private state directory for the artifact HMAC key and publish journal:
# AI_EDU_TRACKER_STATE_DIR=/absolute/private/state-directory
# Optional best-effort duplicate metadata filter (not a CLI argument):
# FEISHU_PARENT_NODE_TOKEN=replace-with-parent-node-token
